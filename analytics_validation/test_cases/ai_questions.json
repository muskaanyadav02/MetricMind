  {
    "id": "q2",
    "question": "Show top 5 active users by transaction count",
    "expected_sql": "SELECT user_id, COUNT(*) as tx_count FROM transactions GROUP BY user_id ORDER BY tx_count DESC LIMIT 5",
    "expected_columns": ["user_id", "tx_count"]
