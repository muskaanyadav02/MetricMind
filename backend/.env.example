# MetricMind backend - example environment file.
#
# Copy to backend/.env and fill in for local development:
#     cp backend/.env.example backend/.env
#
# backend/.env is gitignored and MUST NOT be committed. This file contains
# placeholder values only and no real credentials.
#
# The application starts, imports and runs its entire test suite with every
# value below unset. Without Snowflake credentials the warehouse-dependent
# endpoint (POST /api/v1/chat/query) returns HTTP 503 with a
# configuration_error naming the missing settings - it never returns fake data.

# --- Application -----------------------------------------------------------
APP_NAME=MetricMind Backend
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=false

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed browser origins. The frontend framework is
# not yet fixed in this repository, so this is configuration rather than a
# hardcoded origin. Do not use "*" together with credentials.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# --- Timeouts and result limits -------------------------------------------
REQUEST_TIMEOUT_SECONDS=30
WAREHOUSE_TIMEOUT_SECONDS=30
MAX_RESULT_ROWS=500
DEFAULT_RESULT_ROWS=100

# --- Warehouse selection ---------------------------------------------------
# snowflake (dbt MART tables) | cube (semantic layer, cube/model/FactSales.js)
WAREHOUSE_BACKEND=snowflake

# --- Snowflake -------------------------------------------------------------
# Values only; no credentials are committed to this repository.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=METRICMIND_WH

# Defaults match the objects documented in docs/data_dictionary.md.
SNOWFLAKE_DATABASE=METRICMIND
SNOWFLAKE_SCHEMA=MART

# Optional. Leave blank for standard username/password authentication
# (snowflake-connector-python's default). Set to e.g. "externalbrowser",
# "snowflake_jwt" or "oauth" only if the team uses that method.
SNOWFLAKE_AUTHENTICATOR=

# --- Cube.dev (semantic layer) --------------------------------------------
# Read when WAREHOUSE_BACKEND=cube. CUBE_API_URL is the Cube REST API base,
# e.g. http://localhost:4000/cubejs-api/v1 for a local deployment.
# CUBE_API_TOKEN is optional: Cube's development mode (CUBEJS_DEV_MODE=true,
# the default for local cubejs/Docker setups) is a documented authentication
# bypass. When set, it is sent as the Authorization header. Never commit a
# real token.
CUBE_API_URL=
CUBE_API_TOKEN=
